<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately kept out of Cadence.slnx and given no ProjectReference.

       These files are the fixtures the GPX and FIT parsers are proven against.
       If the generator shared code with the parsers, a wrong constant (a bad
       semicircle divisor, the wrong FIT epoch) would be written and read back
       identically and every test would still pass. The encoders here are an
       independent second implementation of the same specifications, so a
       disagreement between them is a real disagreement.

       Run it from the repository root with dotnet run, pointing at this
       project; an optional output directory may be passed as an argument. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cadence.Tools.GenerateSamples</RootNamespace>
    <AssemblyName>GenerateSamples</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
