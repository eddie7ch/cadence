# Copy to .env and edit. Every value here is already the Compose default, so an
# empty .env - or no .env at all - starts a working stack.
#
#   cp .env.example .env
#   docker compose up --build

# ---------------------------------------------------------------------------
# Published host ports
#
# Deliberately not 5432/6379/3000. Those are almost always already bound on a
# machine that does any other development, and the first thing a port clash
# costs is the reviewer's patience.
# ---------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=5173
POSTGRES_PORT=5434
REDIS_PORT=6381

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# HMAC signing key. Must be at least 32 bytes; anything shorter is rejected at
# start-up rather than silently weakening the tokens. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=cadence-local-development-signing-key-change-me
JWT_ISSUER=cadence
JWT_AUDIENCE=cadence
JWT_LIFETIME_MINUTES=720

# ---------------------------------------------------------------------------
# Optional: AI coaching summaries
#
# Leave blank. Blank means "not configured", and the API reports the coaching
# feature as unavailable instead of failing requests against an endpoint it has
# no credentials for. Everything else in the application works without it.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Web
#
# Vite inlines VITE_* variables at build time, so this is a build argument and
# not a runtime setting. If you change API_PORT, change this to match, then
# rebuild the web image (docker compose up --build web).
#
# Include the /api/v1 prefix: the client appends resource paths to this value.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
